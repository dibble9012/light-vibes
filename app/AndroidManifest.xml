<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="lightvibes.app" android:versionCode="1" android:versionName="0.5.0">
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19"/>
    <!-- this head unit's Activity.finish() (so the back button too) checks it: without it the app crashes -->
    <uses-permission android:name="android.permission.GET_TASKS"/>
    <application android:label="Light Vibes" android:icon="@drawable/ic_app"
        android:theme="@android:style/Theme.Holo.NoActionBar" android:allowBackup="false">
        <!-- newer Android (the emulator) squeezes old apps without this; the car ignores it -->
        <meta-data android:name="android.max_aspect" android:value="4.0"/>
        <activity android:name=".MainActivity" android:label="Light Vibes"
            android:screenOrientation="landscape" android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
